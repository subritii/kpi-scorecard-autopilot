#!/bin/sh
# Pre-commit hook: block the commit unless ruff and the full test suite pass.
# Install once per clone:  git config core.hooksPath .githooks
#
# Uses the API's virtualenv when present, otherwise whatever is on PATH.
# Live tests (real Ollama) are skipped by default, as in a normal pytest run.
# Database tests (row-level security, client isolation, endpoints) must run:
# if Postgres is down or unseeded they would be skipped, so the hook blocks
# the commit instead. Start it with: docker compose up -d postgres

set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ -x "$ROOT/api/.venv/bin/pytest" ]; then
    RUFF="$ROOT/api/.venv/bin/ruff"
    PYTEST="$ROOT/api/.venv/bin/pytest"
else
    RUFF=ruff
    PYTEST=pytest
fi

echo "pre-commit: ruff check"
"$RUFF" check .
echo "pre-commit: ruff format --check"
"$RUFF" format --check .

echo "pre-commit: pytest"
# -rs lists skip reasons, so a skipped database shows up below.
if ! OUTPUT=$(cd api && "$PYTEST" -q -rs -p no:warnings 2>&1); then
    echo "$OUTPUT" | tail -30
    echo "pre-commit: tests failed; commit blocked."
    exit 1
fi
echo "$OUTPUT" | tail -1
# The security tests skip themselves when there is no database to test.
# A skip is not a pass, so treat it as a failure here.
if echo "$OUTPUT" | grep -q -e "database not available" -e "seeded data not found"; then
    echo "$OUTPUT" | grep "SKIPPED" | grep -v "pytest --live"
    echo "pre-commit: database tests were skipped; commit blocked."
    echo "pre-commit: start Postgres (docker compose up -d postgres) and set up the test"
    echo "pre-commit: database (python scripts/setup_test_db.py), then retry."
    exit 1
fi
