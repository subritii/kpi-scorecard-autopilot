# Copy to .env and fill in values. Never commit .env.

# --- Postgres ---
# Admin (superuser): used only by scripts/migrate.py. Superusers bypass RLS.
POSTGRES_USER=kpi_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=kpi_scorecard
ADMIN_DATABASE_URL=postgresql://kpi_admin:change-me-admin@localhost:5432/kpi_scorecard
# app_user (RLS enforced): used by the API, seed script, and tests.
# The role is created by db/migrations/004_app_user.sql; migrate.py sets this password.
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/kpi_scorecard

# --- LLM provider: azure_openai | ollama ---
LLM_PROVIDER=ollama
# Must match the embedding model's output size (e.g. 768 for nomic-embed-text,
# 1536 for text-embedding-3-small).
EMBEDDING_DIM=768

# Azure OpenAI (only needed when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Ollama (only needed when LLM_PROVIDER=ollama)
# host.docker.internal lets the api container reach Ollama running on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- n8n ---
N8N_VERSION=latest
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
TIMEZONE=America/New_York

# --- Integrations (sandbox only) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
CLICKUP_API_TOKEN=
