# Copy to .env and fill in values. Never commit .env.

# --- Postgres ---
# Admin (superuser): used only by scripts/migrate.py and scripts/seed_db.py. Bypasses RLS.
POSTGRES_USER=kpi_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=kpi_scorecard
ADMIN_DATABASE_URL=postgresql://kpi_admin:change-me-admin@localhost:5432/kpi_scorecard
# app_user (RLS enforced): used only by the API and tests.
# The role is created by db/migrations/004_app_user.sql; migrate.py sets this password.
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/kpi_scorecard
# Test database: the test suite uses only this (tests/conftest.py), never the
# dev/demo database above. Create it with: python scripts/setup_test_db.py
TEST_ADMIN_DATABASE_URL=postgresql://kpi_admin:change-me-admin@localhost:5432/kpi_scoreboard_test
TEST_DATABASE_URL=postgresql://app_user:change-me-app@localhost:5432/kpi_scoreboard_test

# --- API ---
# Every request needs the header X-API-Key with this value (n8n: Header Auth credential).
# At least 32 characters; the API refuses to start otherwise. Generate with: openssl rand -hex 32
API_KEY=
# true opens /docs and /openapi.json WITHOUT the API key. Development only.
DOCS_ENABLED=false

# --- Links for people (approval page, owner reply form) ---
# Signs the single-use links in emails. 32+ characters; the API won't start otherwise.
# Generate with: openssl rand -hex 32. Separate from API_KEY.
LINK_SECRET=
# Where a browser reaches the API (the links point here).
PUBLIC_BASE_URL=http://localhost:8000
# How long a link works, in hours (1-720).
LINK_TTL_HOURS=72
# How often n8n's send workflow polls for approved packets, in minutes (1 in development).
SEND_POLL_INTERVAL_MINUTES=1

# --- Email (fail safe: the API won't start until you choose a mode) ---
# Test mode: set TEST_EMAIL_OVERRIDE (e.g. you@gmail.com). Every email the API
# composes then goes to a plus-alias of this inbox
# (ceo@brightline.example -> you+ceo.brightline@gmail.com), with a banner naming
# the real recipients.
# Live mode: leave TEST_EMAIL_OVERRIDE empty and set EMAIL_MODE=live. Only then
# do emails go to real addresses. Neither (or both) set: the API refuses to start.
TEST_EMAIL_OVERRIDE=
EMAIL_MODE=

# --- LLM provider: ollama (default) | azure_openai | fake (tests/offline, no model) ---
LLM_PROVIDER=ollama
# Must match the embedding model's output size (e.g. 768 for nomic-embed-text,
# 1536 for text-embedding-3-small).
EMBEDDING_DIM=768

# Azure OpenAI (only needed when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Ollama (only needed when LLM_PROVIDER=ollama)
# Ollama runs natively on the host. This URL is for running the API, scripts and
# tests on the host; docker-compose.yml overrides it for the api container with
# http://host.docker.internal:11434 (the host, as seen from inside Docker).
OLLAMA_BASE_URL=http://localhost:11434
# llama3.2:3b fits comfortably in 8 GB RAM; llama3.1 (8B) is better but needs ~5 GB free.
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Retrieval ---
# Minimum cosine similarity for /retrieve to return a past explanation. Scores
# differ between embedding models, so re-tune it per model (pytest --live -s).
# 0.73 is tuned for nomic-embed-text on a small test set; see README.
RETRIEVAL_MIN_SIMILARITY=0.73

# --- n8n ---
N8N_VERSION=latest
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
TIMEZONE=America/New_York

# --- Integrations (sandbox only) ---
# QuickBooks: the OAuth connection lives in n8n's "QuickBooks Sandbox" credential.
# This is only the sandbox Company ID (realm id): Sandbox Co's QuickBooks company.
# Not a secret, but specific to your sandbox, so it stays out of the repo.
QBO_REALM_ID=
CLICKUP_API_TOKEN=
